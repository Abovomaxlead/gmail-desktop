{
  "name": "gmail-desktop",
  "version": "1.0.1-beta.1793366777",
  "private": true,
  "description": "Cross-platform desktop wrapper for Gmail",
  "author": "Luca Manuel <luca.manuel@abovomaxlead.nl>",
  "homepage": "https://abovomaxlead.nl",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "npm run build --prefix renderer",
    "build:main": "esbuild electron/main.ts electron/preload.ts electron/sidebar-preload.ts --bundle --platform=node --target=node24 --external:electron --outdir=dist-electron --format=cjs",
    "build": "npm run build:renderer && npm run build:main",
    "bundle:oauth-config": "node scripts/bundle-oauth-config.mjs",
    "check:oauth": "node scripts/check-bundled-oauth.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "npm run check:oauth && npm run build && electron-builder --publish never",
    "release": "npm run check:oauth && npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
