{
  "name": "gmail-desktop",
  "version": "1.0.0-beta.1788351630",
  "private": true,
  "description": "Cross-platform desktop wrapper for Gmail",
  "author": "Luca Manuel <luca.manuel@abovomaxlead.nl>",
  "homepage": "https://abovomaxlead.nl",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "npm run build --prefix renderer",
    "build:main": "esbuild electron/main.ts electron/preload.ts electron/sidebar-preload.ts --bundle --platform=node --target=node22 --external:electron --outdir=dist-electron --format=cjs",
    "build": "npm run build:renderer && npm run build:main",
    "bundle:oauth-config": "node scripts/bundle-oauth-config.mjs",
    "check:oauth": "node scripts/check-bundled-oauth.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "npm run check:oauth && npm run build && electron-builder --publish never",
    "release": "npm run check:oauth && npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
